{
  "name": "cxas-agy-dsc-demo-monorepo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:eval": "npm run test:eval --workspace=@dsc/agent",
    "eval:remote": "npm run eval:remote --workspace=@dsc/agent",
    "sync:agent": "npm run sync:agent --workspace=@dsc/agent",
    "tf:plan": "GOOGLE_OAUTH_ACCESS_TOKEN=$(gcloud auth print-access-token) tofu -chdir=infra/terraform plan",
    "tf:apply": "GOOGLE_OAUTH_ACCESS_TOKEN=$(gcloud auth print-access-token) tofu -chdir=infra/terraform apply -auto-approve",
    "tf:destroy": "GOOGLE_OAUTH_ACCESS_TOKEN=$(gcloud auth print-access-token) tofu -chdir=infra/terraform destroy -auto-approve"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "yaml": "^2.7.0"
  }
}
